rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
      function isAdmin() {
        return signedIn() && (
          request.auth.token.admin == true ||
          request.auth.token.email == 'admin@jackx.app' ||
          request.auth.token.email == 'admin@staff.jackx.app' ||
          request.auth.token.email == 'adminmosaad@staff.jackx.app' ||
          (exists(/databases/$(database)/documents/staff/$(request.auth.token.email)) &&
            (
              get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'admin' ||
              get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'manager' ||
              get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role == 'مدير'
            ))
        );
      }
      function isStaff() { return signedIn() && (isAdmin() || exists(/databases/$(database)/documents/staff/$(request.auth.token.email))); }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
      match /orders/{orderId} {
        allow create: if true;
        allow read: if isStaff() || (signedIn() && resource.data.userId == request.auth.uid);
        allow update: if isStaff();
        allow delete: if isAdmin();
      }
      match /customers/{customerId} {
        allow read: if isAdmin() || (signedIn() && request.auth.uid == customerId);
        allow create, update: if signedIn() && request.auth.uid == customerId;
        allow delete: if signedIn() && request.auth.uid == customerId;
      }
      match /staff/{staffId} {
        allow read: if isAdmin();
        allow create, update, delete: if isAdmin();
      }
      match /settings/{settingId} {
        allow read: if isStaff();
        allow create, update, delete: if isAdmin();
      }
      match /expenses/{expenseId} {
        allow read, create, update, delete: if isAdmin();
      }
    match /expenses/{expenseId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /staff/{staffId} {
      allow read, create, update, delete: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
